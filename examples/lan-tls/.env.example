# Copy to .env next to this compose.yaml.

# The host name clients will use, e.g. patents.lan or a VPN name. It is both
# the certificate name Caddy serves and the only Host header the server accepts.
PATENT_CHECKER_LAN_HOST=

# Operator notice acknowledgement, exactly as for the top-level deployment:
#   docker compose run --rm patent-checker serve --show-operator-notice --lang ja
PATENT_CHECKER_OPERATOR_CONSENT=

# Optional: bind Caddy to one interface only (default 0.0.0.0) and pick a port.
# PATENT_CHECKER_LAN_BIND=10.8.0.1
# PATENT_CHECKER_LAN_PORT=443

# Optional: image and log level, as in the top-level deployment.
# PATENT_CHECKER_IMAGE=ghcr.io/xhighhongo41/patent-checker:0.5
# PATENT_CHECKER_LOG_LEVEL=info
