# Copy this file to .env and fill in your own credentials.
# Never commit .env; secrets must not appear in the repository, logs, or docs.
#
# Where it is looked for: patent-checker reads the first .env found in the
# working directory or one of its parents, stopping before your home
# directory and before the filesystem root -- neither of those two is read.
# It is read once per run.

# EPO OPS consumer credentials (register at https://developers.epo.org/,
# then My Apps -> add an app to obtain the key/secret pair).
PATENT_CHECKER_OPS_KEY=
PATENT_CHECKER_OPS_SECRET=

# Optional: data directory (search cache, request log; the CLI also keeps
# its exploration artifacts here). Defaults to ./.patent-checker for the CLI
# and to the per-user data directory for the MCP server. When set, the
# shared document cache is placed under it too (<dir>/cache) unless
# PATENT_CHECKER_CACHE_DIR is also set.
# PATENT_CHECKER_DATA_DIR=

# Optional: shared document cache (biblio, claims, legal status, family,
# Google Patents pages), reused across projects and by the CLI and the
# server alike. Defaults to <per-user data dir>/cache, e.g.
# ~/.local/share/patent-checker/cache (Linux/macOS) or
# %LOCALAPPDATA%\patent-checker\cache (Windows).
# PATENT_CHECKER_CACHE_DIR=

# Optional: per-kind cache expiry overrides, comma-separated kind=ttl.
# Kinds: biblio, claims, legal, family, gp, search, searchbib. A ttl is
# <n>d (days), <n>h (hours) or 0 (never expires; it does not mean "do not
# cache"). Defaults: biblio=90d,
# claims=0, legal=7d, family=30d, gp=0, search=1d, searchbib=1d. An
# invalid value is a configuration error (no silent fallback).
# PATENT_CHECKER_CACHE_TTL=legal=3d,family=14d

# MCP server settings (patent-checker serve). The server refuses to start
# until the operator notice has been read and acknowledged: run
# `patent-checker serve --show-operator-notice` (add `--lang ja` for the
# Japanese version), then set this to the version number shown there
# (currently 1.0).
PATENT_CHECKER_OPERATOR_CONSENT=

# Note for docker compose users: compose.yaml does not read this file for
# the container. It takes the OPS credentials and the bearer token from the
# files under secrets/ (see secrets/README.md) and reads only
# PATENT_CHECKER_OPERATOR_CONSENT (and optionally PATENT_CHECKER_IMAGE,
# PATENT_CHECKER_PORT, PATENT_CHECKER_LOG_LEVEL) from a .env next to it.

# Bearer token required by the http transport (not used by stdio). Supply
# either the value directly or a file path via the _FILE variant; exactly
# one of the two may be set. Generate a token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PATENT_CHECKER_SERVER_TOKEN=
# PATENT_CHECKER_SERVER_TOKEN_FILE=

# Optional: interface/port to bind (http transport). Defaults to
# 127.0.0.1:8642.
# PATENT_CHECKER_SERVER_HOST=
# PATENT_CHECKER_SERVER_PORT=8642

# Required when PATENT_CHECKER_SERVER_HOST is not a loopback address:
# comma-separated hostnames clients will use in the Host header. Names only:
# wildcards (* ? [) are rejected, and an IPv6 address is written without
# brackets. TLS must then be provided by a reverse proxy in front of the
# server (see docs/deploy-lan.md).
# PATENT_CHECKER_SERVER_ALLOWED_HOSTS=

# Optional: server log level (debug, info, warning, error; default info).
# All server logs, including the access log, go to standard error.
# PATENT_CHECKER_LOG_LEVEL=info

# Optional: rate limit on incoming MCP requests (a guard against runaway
# agent loops; upstream OPS/Google Patents pacing is handled separately).
# Defaults to 5 requests/second with a burst of 10.
# PATENT_CHECKER_SERVER_RPS=5
# PATENT_CHECKER_SERVER_BURST=10
