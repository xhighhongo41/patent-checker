# Copy this file to .env and fill in your own credentials.
# Never commit .env; secrets must not appear in the repository, logs, or docs.

# EPO OPS consumer credentials (register at https://developers.epo.org/,
# then My Apps -> add an app to obtain the key/secret pair).
PATENT_CHECKER_OPS_KEY=
PATENT_CHECKER_OPS_SECRET=

# Optional: override the directory where raw API responses are stored.
# PATENT_CHECKER_DATA_DIR=

# MCP server settings (patent-checker serve). The server refuses to start
# until the operator notice has been read and acknowledged: run
# `patent-checker serve --show-operator-notice` (add `--lang ja` for the
# Japanese version), then set this to the version number shown there
# (currently 1.0).
PATENT_CHECKER_OPERATOR_CONSENT=

# Bearer token required by the http transport (not used by stdio). Supply
# either the value directly or a file path via the _FILE variant; exactly
# one of the two may be set. Generate a token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PATENT_CHECKER_SERVER_TOKEN=
# PATENT_CHECKER_SERVER_TOKEN_FILE=

# Optional: interface/port to bind (http transport). Defaults to
# 127.0.0.1:8642.
# PATENT_CHECKER_SERVER_HOST=
# PATENT_CHECKER_SERVER_PORT=8642

# Required when PATENT_CHECKER_SERVER_HOST is not a loopback address:
# comma-separated hostnames clients will use in the Host header. TLS must
# then be provided by a reverse proxy in front of the server.
# PATENT_CHECKER_SERVER_ALLOWED_HOSTS=

# Optional: rate limit on incoming MCP requests (a guard against runaway
# agent loops; upstream OPS/Google Patents pacing is handled separately).
# Defaults to 5 requests/second with a burst of 10.
# PATENT_CHECKER_SERVER_RPS=5
# PATENT_CHECKER_SERVER_BURST=10
